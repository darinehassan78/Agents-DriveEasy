{
  "name": "driveeasy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "db:setup": "tsx scripts/setup-local-db.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:studio": "drizzle-kit studio",
    "job": "tsx scripts/run-job.mts",
    "jobs:release-expired-holds": "tsx scripts/run-job.mts release-expired-holds",
    "test:integration": "vitest run --config tests/vitest.config.mts",
    "test:db:reset": "tsx tests/support/reset-db.mts",
    "test:all": "vitest run && vitest run --config tests/vitest.config.mts && playwright test",
    "db:migrate:test": "tsx scripts/migrate.mts --test",
    "db:seed": "tsx scripts/seed.mts",
    "db:reset": "tsx scripts/reset-db.mts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0"
}
