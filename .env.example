# DriveEasy settings. Copy to .env.local and fill in. Never commit real values.
# Each local stand-in is chosen by a *_PROVIDER / *_DRIVER / SCHEDULER setting;
# switching to the cloud service means changing these values only.

# --- App ---------------------------------------------------------------------
APP_URL=http://localhost:3000

# --- Database (local PostgreSQL now, hosted PostgreSQL later) ------------------
DATABASE_URL=postgres://driveeasy:<password>@localhost:5432/driveeasy_dev
TEST_DATABASE_URL=postgres://driveeasy:<password>@localhost:5432/driveeasy_test
# Optional: superuser connection used only by `pnpm db:setup`
# PG_ADMIN_URL=postgres://postgres:<password>@localhost:5432/postgres

# --- Authentication (Better Auth, email + password) ---------------------------
BETTER_AUTH_SECRET=<random 32+ characters>
BETTER_AUTH_URL=http://localhost:3000

# --- Payments: fake | stripe -----------------------------------------------------
PAYMENT_PROVIDER=fake
PAYMENT_WEBHOOK_URL=http://localhost:3000/api/webhooks/payments
PAYMENT_WEBHOOK_SECRET=<random 16+ characters>
# Fake provider only: send every webhook twice to exercise duplicate handling
FAKE_PAYMENT_DUPLICATE_WEBHOOKS=false
# Cloud (when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- File uploads: local | s3 --------------------------------------------------
STORAGE_DRIVER=local
LOCAL_UPLOADS_DIR=storage/uploads
# Cloud (when STORAGE_DRIVER=s3; any S3-compatible service)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Scheduled jobs: local | cloud-cron ------------------------------------------
SCHEDULER=local
# Shared secret a cloud cron service must send when triggering jobs
CRON_SECRET=<random 16+ characters>
HOLD_TTL_MINUTES=15

# --- Email (future; not used locally yet) ------------------------------------------
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=
